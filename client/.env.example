# --- Client (unica configurazione esposta al bundle: solo VITE_*) ---
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# --- Mock server (dev-only, mai nel bundle) ---
MOCK_PORT=8080
# pvp | checkmate | abandon | reconnect | timeout | draw | spells | hostile | contract-minimal
MOCK_SCENARIO=pvp
MOCK_SEED=42
MOCK_RECONNECT_TIMEOUT_MS=30000
MOCK_CLOCK_MS=600000
MOCK_JWT_TTL_S=86400
