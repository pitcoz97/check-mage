# --- Client (unica configurazione esposta al bundle: solo VITE_*) ---
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# --- Mock server (dev-only, mai nel bundle) ---
MOCK_PORT=8080
# pvp | checkmate | abandon | reconnect | restart | timeout | draw | spells | hostile  (anche via ?scenario= su /ws)
MOCK_SCENARIO=pvp
MOCK_SEED=42
MOCK_BASE_TIME_MS=600000
MOCK_INCREMENT_MS=5000
MOCK_RECONNECT_TIMEOUT_MS=30000
MOCK_ACCESS_TTL_S=86400
# IP o CIDR IPv4 separati da virgola: solo da questi si accettano X-Forwarded-For / X-Real-IP (TRUSTED_PROXIES)
MOCK_TRUSTED_PROXIES=
