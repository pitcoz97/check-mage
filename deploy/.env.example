# Copia questo file in deploy/.env e compila i cinque valori (guida: docs/DEPLOY.md, passo 8).
# deploy/.env contiene segreti: non va mai messo su GitHub (è già nel .gitignore).

# Il dominio del sito, senza https:// (es. checkmage.it)
APP_DOMAIN=
# Il sottodominio del server (es. api.checkmage.it)
API_DOMAIN=
# La tua email: serve solo a Let's Encrypt per gli avvisi sui certificati
ACME_EMAIL=

# Password del database: generala con  openssl rand -hex 24
DB_PASSWORD=
# Segreto per i login: generalo con  openssl rand -hex 32
JWT_SECRET=
