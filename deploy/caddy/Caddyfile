# I domini arrivano da deploy/.env. Caddy ottiene e rinnova da solo i certificati HTTPS (Let's Encrypt).
{
	email {$ACME_EMAIL}
}

# Il sito: i file del client. Ogni percorso che non è un file (/decks, /collection…) apre index.html.
{$APP_DOMAIN} {
	encode zstd gzip
	root * /srv/client

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}

# Il server: REST e WebSocket.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy server:8080
}
